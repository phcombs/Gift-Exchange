#!/bin/sh
# Starts Gift Exchange on macOS or Linux: ./run   (the same as: python3 run.py)
cd "$(dirname "$0")" || exit 1
if command -v python3 >/dev/null 2>&1; then
  exec python3 run.py "$@"
fi
if command -v python >/dev/null 2>&1; then
  exec python run.py "$@"
fi
echo "Gift Exchange needs Python 3. Install it from https://www.python.org/downloads/ and try again."
exit 1
